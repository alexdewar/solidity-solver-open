$(OBJDIR_RELEASE)/Y3Dcd.o: Y3Dcd.c
	$(CC) $(CFLAGS_RELEASE) $(INC_RELEASE) -c Y3Dcd.c -o $(OBJDIR_RELEASE)/Y3Dcd.o

$(OBJDIR_RELEASE)/Y3Dod.o: Y3Dod.cpp
	$(CXX) $(CFLAGS_RELEASE) $(INC_RELEASE) -c Y3Dod.cpp -o $(OBJDIR_RELEASE)/Y3Dod.o

$(OBJDIR_RELEASE)/Y3Dmd.o: Y3Dmd.c
	$(CC) $(CFLAGS_RELEASE) $(INC_RELEASE) -c Y3Dmd.c -o $(OBJDIR_RELEASE)/Y3Dmd.o

clean_release: 
	rm -f $(OBJ_RELEASE) $(OUT_RELEASE)
	rm -rf bin/Release
	rm -rf $(OBJDIR_RELEASE)

.PHONY: before_debug after_debug clean_debug before_release after_release clean_release

